<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gzr.game"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- 存储权限：Android 6+ 写私有目录不需要权限，
         这里只为兼容低版本上的外存缓存目录。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- OpenGL ES 2.0：虽然本应用走软件光栅化，
         但 NativeActivity 所在平台仍声明此特性以便正常分发。 -->
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <application
        android:label="蛊真人"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:extractNativeLibs="true">

        <!-- 入口：先探活 native 库，再转起真正的游戏 Activity。
             详见 LaunchActivity 的说明。 -->
        <activity
            android:name=".LaunchActivity"
            android:label="蛊真人"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GzrActivity"
            android:label="蛊真人"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">

            <meta-data android:name="android.app.lib_name"
                       android:value="guzhenren" />
        </activity>
    </application>

</manifest>
